{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/lifting-order/:slug",
      "destination": "/lifting/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/rules/coaches",
      "destination": "/rules/coach-responsibilities",
      "permanent": true
    },
    {
      "source": "/rules/competition-day",
      "destination": "/rules",
      "permanent": true
    },
    {
      "source": "/rules/equipment",
      "destination": "/rules/equipment-check",
      "permanent": true
    },
    {
      "source": "/rules/equipped",
      "destination": "/rules/equipped-kit",
      "permanent": true
    },
    {
      "source": "/rules/kit",
      "destination": "/rules/general-kit-rules",
      "permanent": true
    },
    {
      "source": "/rules/records",
      "destination": "/records",
      "permanent": true
    },
    {
      "source": "/rules/referees",
      "destination": "/rules/referee-roles",
      "permanent": true
    },
    {
      "source": "/rules/safety",
      "destination": "/rules/conduct-and-safety",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co https://*.stripe.com; font-src 'self' data:; connect-src 'self' https://*.supabase.co https://docs.google.com https://*.googleusercontent.com https://*.stripe.com https://*.stripe.network; frame-src https://*.stripe.com https://*.stripe.network; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
